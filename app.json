{
  "expo": {
    "name": "Boyz at the Back",
    "slug": "boyz-at-the-back",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "boyzattheback",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#1E1E24"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.boyzattheback.app"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#1E1E24"
      },
      "package": "com.boyzattheback.app"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#FF5F1F"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}